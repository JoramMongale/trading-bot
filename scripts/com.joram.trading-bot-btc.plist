<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joram.trading-bot-btc</string>

    <!-- REAL MONEY account 161693049 (Exness-MT5Real21, currency USC).
         Runs the BTCUSDc live bot (magic 77021) under launchd 24/7.
         Entry point is a plain, readable script in this repo:
           scripts/launchd_run_live.sh btc

         Install:
           cp scripts/com.joram.trading-bot-btc.plist ~/Library/LaunchAgents/
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.joram.trading-bot-btc.plist

         STOP FOR GOOD:
           launchctl bootout gui/$(id -u)/com.joram.trading-bot-btc
         A plain `kill` on the bot only causes launchd to restart it within ~60s.

         The agent stands down automatically while a manual supervise_live.sh
         bot is running (it exits 0 when output/live_btc.pid is alive), so it
         is safe to bootstrap while the manual supervisors are up. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/joram/projects/trading-bot/scripts/launchd_run_live.sh</string>
        <string>btc</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/joram/projects/trading-bot</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the bot if it exits for any reason. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Never respawn faster than once a minute. After a reboot the colima VM
         and the MT5 terminal take minutes to become usable, and the wrapper
         exits non-zero until they are; without throttling this would hot-loop. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/joram/projects/trading-bot/output/launchd_live_btc.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/joram/projects/trading-bot/output/launchd_live_btc.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
